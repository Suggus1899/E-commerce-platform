# ==========================================
# E-commerce Platform - environment variables
# ==========================================
# Copy this file to `.env` (docker-compose loads it automatically) and adjust
# the values for your environment. Do NOT commit the real `.env` file.

# --- JWT (shared secret used by user-service, product-service and cart-service) ---
# Must be a Base64-encoded string. user-service uses it to SIGN tokens (HS256);
# product-service and cart-service only VALIDATE tokens with the same secret.
# ⚠️ PRODUCTION: docker-compose.yml falls back to the value below if this is unset.
# That fallback is committed to the repo and therefore PUBLIC — you MUST override
# it with your own secret before any non-local deploy. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=REDACTED

# --- Initial admin account (created automatically by user-service on startup if missing) ---
# ⚠️ PRODUCTION: docker-compose.yml falls back to ADMIN_PASSWORD=ChangeMe123! if this
# is unset — that password is committed to the repo and therefore PUBLIC. You MUST set
# a real password here before any non-local deploy, or the admin panel is wide open.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Product image uploads (product-service writes to this path inside its container) ---
APP_UPLOAD_DIR=/data/uploads

# ==========================================
# Frontend (frontend/.env.local — Next.js, not read by docker-compose)
# ==========================================
# Base URL of the nginx gateway that fronts the backend (no trailing slash, no /api).
# In local dev with `docker-compose up`, nginx listens on port 80.
NEXT_PUBLIC_API_URL=http://localhost

# WhatsApp number used for manual checkout, E.164 format without the leading "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000
